---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Tag from '../components/Tag.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Modal from '../components/Modal.astro';
import projects from '../data/projects.json';
import resumeUrl from '../../assets/resume.pdf?url';

const links = {
  github: 'https://github.com/JiviteshS787',
  linkedin: 'https://www.linkedin.com/in/Jivitesh-Singh',
  email: 'mailto:jivitesh.singh@outlook.com',
};

const ordered = [...projects].sort((a, b) => Number(b.featured) - Number(a.featured));
const filters = ['All', 'Software', 'Hardware'];

// Placeholders until step 3 fills real content from the resume.
const experience = [
  { role: 'Role title', org: 'Organization', dates: 'Dates', points: ['Bullet point one.', 'Bullet point two.'] },
  { role: 'Degree', org: 'School', dates: 'Dates', points: ['Detail line.'] },
];
const skillGroups = ['Languages', 'Frameworks & Libraries', 'Developer Tools', 'Hardware', 'Concepts'];
---

<Base title="Jivitesh Singh · Portfolio" description="Portfolio placeholder description.">
  <Nav slot="header" resumeUrl={resumeUrl} />

  <section class="hero container" aria-labelledby="hero-title">
    <p class="hero__eyebrow mono" data-reveal>Hero eyebrow</p>
    <h1 id="hero-title" class="hero__title" data-reveal>Hero headline placeholder: one sentence about what you build.</h1>
    <p class="hero__lede muted" data-reveal>Supporting line placeholder.</p>
    <div class="hero__actions" data-reveal>
      <Button href={resumeUrl} variant="primary" download="Jivitesh-Singh-Resume.pdf">Resume</Button>
      <Button href={links.github} external>GitHub</Button>
      <Button href={links.linkedin} external>LinkedIn</Button>
      <Button href={links.email}>Email</Button>
    </div>
  </section>

  <Section id="projects" eyebrow="01 / Projects" title="Projects heading">
    <div class="filters" role="group" aria-label="Filter projects" data-reveal>
      {filters.map((f, i) => <Tag pressed={i === 0}>{f}</Tag>)}
    </div>
    <ul class="projects" role="list">
      {ordered.map((project) => <ProjectCard project={project} />)}
    </ul>
    <p class="more muted mono" data-reveal>More on GitHub: placeholder, placeholder</p>
  </Section>

  <Section id="experience" eyebrow="02 / Experience" title="Experience heading">
    <ol class="timeline" role="list">
      {
        experience.map((item) => (
          <Card as="li" data-reveal>
            <div class="timeline__head">
              <div>
                <h3>{item.role}</h3>
                <p class="muted">{item.org}</p>
              </div>
              <p class="timeline__dates mono">{item.dates}</p>
            </div>
            <ul class="timeline__points">
              {item.points.map((p) => <li>{p}</li>)}
            </ul>
          </Card>
        ))
      }
    </ol>
  </Section>

  <Section id="skills" eyebrow="03 / Skills" title="Skills heading">
    <div class="skills">
      {
        skillGroups.map((group) => (
          <Card data-reveal>
            <h3 class="skills__title mono">{group}</h3>
            <ul class="skills__chips" role="list">
              {['Skill', 'Skill', 'Skill', 'Skill'].map((s) => (
                <li>
                  <Tag>{s}</Tag>
                </li>
              ))}
            </ul>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section id="contact" eyebrow="04 / Contact" title="Contact heading">
    <Card class="contact" data-reveal>
      <p class="muted">Contact blurb placeholder.</p>
      <div class="contact__actions">
        <Button href={links.email} variant="primary">Email</Button>
        <Button href={links.linkedin} external>LinkedIn</Button>
        <Button href={links.github} external>GitHub</Button>
      </div>
    </Card>
  </Section>

  <footer slot="footer" class="footer container">
    <p class="muted mono">© {new Date().getFullYear()} Jivitesh Singh</p>
  </footer>

  <Modal id="project-modal" labelledby="project-modal-title">
    <h2 id="project-modal-title">Project title</h2>
  </Modal>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8) var(--space-7);
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: var(--space-9) var(--space-8);
    }
  }

  .hero__eyebrow {
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  .hero__title {
    max-width: 20ch;
    font-size: var(--text-hero);
    font-weight: 700;
  }

  .hero__lede {
    max-width: 60ch;
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .projects {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    padding: 0;
  }

  @media (min-width: 640px) {
    .projects {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .projects > :global(.project:not(.project--featured):last-child) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 960px) {
    .projects {
      grid-template-columns: repeat(6, 1fr);
    }

    .projects > :global(.project--featured) {
      grid-column: span 3;
    }

    .projects > :global(.project:not(.project--featured)) {
      grid-column: span 2;
    }
  }

  .more {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
  }

  .timeline {
    display: grid;
    gap: var(--space-4);
    padding: 0;
  }

  .timeline__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .timeline__head h3 {
    font-size: var(--text-lg);
  }

  .timeline__dates {
    color: var(--color-accent);
    font-size: var(--text-xs);
  }

  .timeline__points {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-4);
  }

  .skills__title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .skills__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
  }

  .contact {
    align-items: flex-start;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
  }
</style>
