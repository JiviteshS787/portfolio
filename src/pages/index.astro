---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Tag from '../components/Tag.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectDetail from '../components/ProjectDetail.astro';
import Modal from '../components/Modal.astro';
import data from '../data/projects.json';
import type { Project } from '../data/types';
import resumeUrl from '../../assets/resume.pdf?url';

const links = {
  github: 'https://github.com/JiviteshS787',
  linkedin: 'https://www.linkedin.com/in/Jivitesh-Singh',
  email: 'mailto:jivitesh.singh@outlook.com',
};

const projects = data.projects as Project[];
const ordered = [...projects].sort((a, b) => Number(b.featured) - Number(a.featured));
const filters = ['All', 'Software', 'Hardware'];
const reposTab = `${links.github}?tab=repositories`;

// Placeholders until step 3 fills real content from the resume.
const experience = [
  { role: 'Role title', org: 'Organization', dates: 'Dates', points: ['Bullet point one.', 'Bullet point two.'] },
  { role: 'Degree', org: 'School', dates: 'Dates', points: ['Detail line.'] },
];
const skillGroups = ['Languages', 'Frameworks & Libraries', 'Developer Tools', 'Hardware', 'Concepts'];
---

<Base title="Jivitesh Singh · Portfolio" description="Portfolio placeholder description.">
  <Nav slot="header" resumeUrl={resumeUrl} />

  <section class="hero container" aria-labelledby="hero-title">
    <p class="hero__eyebrow mono" data-reveal>Hero eyebrow</p>
    <h1 id="hero-title" class="hero__title" data-reveal>Hero headline placeholder: one sentence about what you build.</h1>
    <p class="hero__lede muted" data-reveal>Supporting line placeholder.</p>
    <div class="hero__actions" data-reveal>
      <Button href={resumeUrl} variant="primary" download="Jivitesh-Singh-Resume.pdf">Resume</Button>
      <Button href={links.github} external>GitHub</Button>
      <Button href={links.linkedin} external>LinkedIn</Button>
      <Button href={links.email}>Email</Button>
    </div>
  </section>

  <Section id="projects" eyebrow="01 / Projects" title="Projects heading">
    <div class="filters" role="group" aria-label="Filter projects" data-reveal>
      {
        filters.map((f, i) => (
          <Tag pressed={i === 0} data-filter={f}>
            {f}
          </Tag>
        ))
      }
    </div>
    <p class="visually-hidden" aria-live="polite" data-filter-status></p>
    <ul class="projects" role="list">
      {ordered.map((project) => <ProjectCard project={project} />)}
    </ul>
    <p class="more muted mono" data-reveal>
      More on GitHub:{' '}
      {
        data.moreOnGitHub.map((item, i) => (
          <>
            {i > 0 && ', '}
            <a href={item.repo ? `https://github.com/${item.repo}` : reposTab} target="_blank" rel="noopener noreferrer">
              {item.title}
            </a>
          </>
        ))
      }
    </p>
  </Section>

  <Section id="experience" eyebrow="02 / Experience" title="Experience heading">
    <ol class="timeline" role="list">
      {
        experience.map((item) => (
          <Card as="li" data-reveal>
            <div class="timeline__head">
              <div>
                <h3>{item.role}</h3>
                <p class="muted">{item.org}</p>
              </div>
              <p class="timeline__dates mono">{item.dates}</p>
            </div>
            <ul class="timeline__points">
              {item.points.map((p) => <li>{p}</li>)}
            </ul>
          </Card>
        ))
      }
    </ol>
  </Section>

  <Section id="skills" eyebrow="03 / Skills" title="Skills heading">
    <div class="skills">
      {
        skillGroups.map((group) => (
          <Card data-reveal>
            <h3 class="skills__title mono">{group}</h3>
            <ul class="skills__chips" role="list">
              {['Skill', 'Skill', 'Skill', 'Skill'].map((s) => (
                <li>
                  <Tag>{s}</Tag>
                </li>
              ))}
            </ul>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section id="contact" eyebrow="04 / Contact" title="Contact heading">
    <Card class="contact" data-reveal>
      <p class="muted">Contact blurb placeholder.</p>
      <div class="contact__actions">
        <Button href={links.email} variant="primary">Email</Button>
        <Button href={links.linkedin} external>LinkedIn</Button>
        <Button href={links.github} external>GitHub</Button>
      </div>
    </Card>
  </Section>

  <footer slot="footer" class="footer container">
    <p class="muted mono">© {new Date().getFullYear()} Jivitesh Singh</p>
  </footer>

  {ordered.map((project) => <ProjectDetail project={project} />)}

  <Modal id="project-modal" labelledby="project-modal-title">
    <div class="modal-body" data-modal-body></div>
    <nav class="modal-nav" aria-label="Browse projects">
      <Button size="sm" data-modal-step="-1">← Previous</Button>
      <span class="modal-nav__count mono muted" data-modal-count></span>
      <Button size="sm" data-modal-step="1">Next →</Button>
    </nav>
  </Modal>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8) var(--space-7);
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: var(--space-9) var(--space-8);
    }
  }

  .hero__eyebrow {
    color: var(--color-accent);
    font-size: var(--text-sm);
  }

  .hero__title {
    max-width: 20ch;
    font-size: var(--text-hero);
    font-weight: 700;
  }

  .hero__lede {
    max-width: 60ch;
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .projects {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    padding: 0;
  }

  @media (min-width: 640px) {
    .projects {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .projects > :global(.project:not(.project--featured):last-child) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 960px) {
    .projects {
      grid-template-columns: repeat(6, 1fr);
    }

    .projects > :global(.project--featured) {
      grid-column: span 3;
    }

    .projects > :global(.project:not(.project--featured)) {
      grid-column: span 2;
    }
  }

  .more {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
  }

  .more a {
    color: var(--color-text);
    text-underline-offset: 3px;
  }

  .more a:hover {
    color: var(--color-accent);
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .modal-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .modal-nav__count {
    font-size: var(--text-xs);
  }

  .timeline {
    display: grid;
    gap: var(--space-4);
    padding: 0;
  }

  .timeline__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .timeline__head h3 {
    font-size: var(--text-lg);
  }

  .timeline__dates {
    color: var(--color-accent);
    font-size: var(--text-xs);
  }

  .timeline__points {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-4);
  }

  .skills__title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .skills__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
  }

  .contact {
    align-items: flex-start;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
  }
</style>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  const dialog = document.querySelector<HTMLDialogElement>('#project-modal')!;
  const body = dialog.querySelector<HTMLElement>('[data-modal-body]')!;
  const count = dialog.querySelector<HTMLElement>('[data-modal-count]')!;
  let currentId: string | null = null;

  // Filtering
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      cards.forEach((card) => {
        card.hidden = filter !== 'All' && card.dataset.category !== filter;
        card.classList.add('is-visible');
      });
      const shown = visibleIds().length;
      if (status) status.textContent = `Showing ${shown} ${filter === 'All' ? '' : `${filter.toLowerCase()} `}project${shown === 1 ? '' : 's'}`;
    });
  });

  const visibleIds = () => cards.filter((c) => !c.hidden).map((c) => c.dataset.project!);

  // Modal
  function show(id: string) {
    const template = document.querySelector<HTMLTemplateElement>(`template[data-project-detail="${id}"]`);
    if (!template) return;
    currentId = id;
    body.replaceChildren(template.content.cloneNode(true));
    const ids = visibleIds();
    count.textContent = `${ids.indexOf(id) + 1} / ${ids.length}`;
    dialog.scrollTop = 0;
    if (!dialog.open) dialog.showModal();
  }

  function step(delta: number) {
    const ids = visibleIds();
    if (!currentId || ids.length < 2) return;
    const next = ids[(ids.indexOf(currentId) + delta + ids.length) % ids.length];
    show(next);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-open-project]').forEach((button) => {
    button.addEventListener('click', () => show(button.dataset.openProject!));
  });

  dialog.querySelectorAll<HTMLButtonElement>('[data-modal-step]').forEach((button) => {
    button.addEventListener('click', () => step(Number(button.dataset.modalStep)));
  });

  dialog.addEventListener('keydown', (e) => {
    if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    if (e.key === 'ArrowRight') step(1);
    else if (e.key === 'ArrowLeft') step(-1);
    else return;
    e.preventDefault();
  });

  // Return focus to the card that matches the project being viewed, which may differ from the one opened.
  // `close` fires async, so skip it if the modal was already reopened.
  dialog.addEventListener('close', () => {
    if (dialog.open) return;
    const button = document.querySelector<HTMLButtonElement>(`[data-open-project="${currentId}"]`);
    body.replaceChildren();
    currentId = null;
    button?.focus();
  });
</script>
