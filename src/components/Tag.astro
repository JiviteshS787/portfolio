---
// Static label (default) or toggleable chip when `pressed` is passed.
interface Props {
  pressed?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { pressed, class: className, ...rest } = Astro.props;
const isToggle = pressed !== undefined;
---

{
  isToggle ? (
    <button type="button" class:list={['tag', 'tag--toggle', className]} aria-pressed={String(pressed)} {...rest}>
      <slot />
    </button>
  ) : (
    <span class:list={['tag', className]} {...rest}>
      <slot />
    </span>
  )
}

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    white-space: nowrap;
  }

  .tag--toggle {
    min-height: 36px;
    padding-inline: var(--space-4);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }

  .tag--toggle:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .tag--toggle[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }
</style>
