---
// Native <dialog> shell. Open with `dialog.showModal()`; Esc closes natively.
// Backdrop clicks and the close button close it via the script below.
interface Props {
  id: string;
  labelledby: string;
}

const { id, labelledby } = Astro.props;
---

<dialog id={id} class="modal" aria-labelledby={labelledby}>
  <div class="modal__inner">
    <button type="button" class="modal__close" data-modal-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    <slot />
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLDialogElement>('dialog.modal').forEach((dialog) => {
    dialog.querySelector('[data-modal-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .modal {
    width: min(100% - var(--gutter) * 2, 760px);
    max-height: min(100% - var(--space-6), 900px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    overflow: auto;
    overscroll-behavior: contain;
  }

  .modal::backdrop {
    background: var(--color-backdrop);
    backdrop-filter: blur(4px);
  }

  :global(html:has(dialog.modal[open])) {
    overflow: hidden;
  }

  .modal__inner {
    --pad: var(--space-5);
    --close-size: 40px;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--pad);
  }

  @media (min-width: 640px) {
    .modal__inner {
      --pad: var(--space-6);
    }
  }

  /* Sticky so it stays reachable while the dialog scrolls; negative bottom margin takes it out of the flow. */
  .modal__close {
    position: sticky;
    top: var(--space-3);
    z-index: 1;
    align-self: flex-end;
    flex-shrink: 0;
    margin: calc(var(--space-3) - var(--pad)) calc(var(--space-3) - var(--pad)) calc(-1 * (var(--close-size) + var(--space-5) + var(--space-3) - var(--pad)));
    display: grid;
    place-items: center;
    width: var(--close-size);
    height: var(--close-size);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    cursor: pointer;
  }

  .modal__close:hover {
    border-color: var(--color-accent);
  }

  .modal__close svg {
    width: 18px;
    height: 18px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .modal[open] {
      animation: modal-in var(--duration) var(--ease);
    }
  }

  @keyframes modal-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }
</style>
