---
interface Props {
  as?: 'article' | 'div' | 'li';
  interactive?: boolean;
  padded?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { as: Tag = 'div', interactive = false, padded = true, class: className, ...rest } = Astro.props;
---

<Tag class:list={['card', { 'card--interactive': interactive, 'card--padded': padded }, className]} {...rest}>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .card--padded {
    padding: var(--space-4);
  }

  @media (min-width: 640px) {
    .card--padded {
      padding: var(--space-5);
    }
  }

  .card--interactive {
    transition:
      transform var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease),
      box-shadow var(--duration-fast) var(--ease);
  }

  .card--interactive:hover,
  .card--interactive:focus-within {
    transform: translateY(var(--lift));
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-lift);
  }
</style>
