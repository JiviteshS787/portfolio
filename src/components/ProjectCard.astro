---
import Card from './Card.astro';
import Media from './Media.astro';
import Tag from './Tag.astro';
import type { Project } from '../data/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const cover = project.media[0];
---

<Card
  as="li"
  interactive
  class:list={['project', { 'project--featured': project.featured }]}
  data-project={project.id}
  data-category={project.category}
  data-reveal
>
  <Media src={cover?.src ?? undefined} type={cover?.type} alt={cover?.alt || `${project.title}: ${cover?.label}`} label={cover?.label} />
  <div class="project__body">
    <p class="project__category mono">{project.category}</p>
    <h3 class="project__title">{project.title}</h3>
    <p class="project__outcome muted">{project.outcome}</p>
  </div>
  <ul class="project__tags" role="list" aria-label="Tech stack">
    {
      project.stack.map((tag) => (
        <li>
          <Tag>{tag}</Tag>
        </li>
      ))
    }
  </ul>
  <div class="project__footer">
    <button type="button" class="project__open mono" data-open-project={project.id} aria-haspopup="dialog">
      Details →<span class="visually-hidden"> about {project.title}</span>
    </button>
    {
      project.repo && (
        <a class="project__repo mono" href={`https://github.com/${project.repo}`} target="_blank" rel="noopener noreferrer">
          Repo ↗<span class="visually-hidden"> for {project.title} (opens in a new tab)</span>
        </a>
      )
    }
  </div>
</Card>

<style>
  .project {
    cursor: pointer;
  }

  .project__body {
    display: grid;
    gap: var(--space-2);
  }

  .project__category {
    color: var(--color-accent);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project__title {
    font-size: var(--text-lg);
  }

  .project--featured .project__title {
    font-size: var(--text-xl);
  }

  .project__outcome {
    font-size: var(--text-sm);
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
  }

  /* The Details button stretches over the whole card so any click opens the modal. */
  .project__open,
  .project__repo {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }

  .project__open {
    padding: var(--space-1) 0;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .project__open::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .project__open:focus-visible {
    outline: none;
  }

  .project:has(.project__open:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .project:hover .project__open {
    color: var(--color-accent);
  }

  .project__repo {
    position: relative;
    z-index: 1;
    padding: var(--space-1) 0;
    color: var(--color-accent);
    text-decoration: none;
  }

  .project__repo:hover {
    text-decoration: underline;
  }
</style>
