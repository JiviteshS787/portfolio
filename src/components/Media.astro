---
// 16:9 media slot. Renders an image, a muted looping video, or a placeholder.
// Videos only autoplay when the viewer allows motion (see Base.astro); otherwise they get controls.
interface Props {
  src?: string;
  type?: 'image' | 'video';
  alt?: string;
  label?: string;
  eager?: boolean;
}

const { src, type = 'image', label = 'Media', eager = false } = Astro.props;
const alt = Astro.props.alt || label;
---

<div class="media">
  {
    !src ? (
      <div class="media__placeholder" role="img" aria-label={`${label} (coming soon)`}>
        <span class="mono" aria-hidden="true">{label}</span>
      </div>
    ) : type === 'video' ? (
      <video src={src} muted loop playsinline preload="metadata" aria-label={alt} data-autoplay />
    ) : (
      <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" width="1600" height="900" />
    )
  }
</div>

<style>
  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
  }

  .media img,
  .media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: center;
  }

  .media__placeholder span {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
</style>
